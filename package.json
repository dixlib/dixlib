  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "rollup": "^4.60.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "workspaces": [
    "nodejs-kernel"
  ]
}
