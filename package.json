{
  "name": "dixlib",
  "description": "A service library for modern JavaScript systems.",
  "version": "0.2.0",
  "author": "dixlib@gmail.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/dixlib/dixlib.git"
  },
  "bugs": {
    "url": "https://github.com/dixlib/dixlib/issues"
  },
  "license": "MIT",
  "type": "module",
  "module": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./rollup.config.js": "./rollup.config.js"
  },
  "types": "./src/api",
  "scripts": {
    "compile": "tsc --build --verbose && rollup --config && npm run compile --workspaces",
    "format": "npx @biomejs/biome format --write --verbose",
    "lint": "npx @biomejs/biome check --verbose",
    "serve": "npm run compile && ws --http2 --log.format dev"
  },
  "engines": {
    "node": ">=24.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "local-web-server": "^5.4.0",
    "rollup": "^4.46.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2"
  },
  "workspaces": ["platform/*"]
}
