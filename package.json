{
  "name": "dixlib",
  "description": "A service library for modern JavaScript systems.",
  "version": "0.3.7",
  "author": "dixlib@gmail.com",
  "keywords": [
    "service locator",
    "actor system",
    "immutable data",
    "distributed system"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dixlib/dixlib.git"
  },
  "bugs": {
    "url": "https://github.com/dixlib/dixlib/issues"
  },
  "license": "MIT",
  "type": "module",
  "module": "./index.js",
  "exports": {
    ".": "./index.js",
    "./bindings.js": "./build/bindings.js",
    "./package.json": "./package.json",
    "./rolldown.config.js": "./rolldown.config.js",
    "./tsconfig-base.json": "./tsconfig-base.json"
  },
  "types": "./src/api",
  "scripts": {
    "compile": "tsc --build --verbose && rolldown --config && npm run compile --workspaces",
    "format": "npx @biomejs/biome format --write --verbose",
    "lint": "npx @biomejs/biome check --verbose"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "rolldown": "^1.0.1",
    "typescript": "^6.0.3"
  },
  "workspaces": [
    "server"
  ]
}
