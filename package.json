{
  "name": "dixlib",
  "description": "A service library for modern JavaScript systems.",
  "version": "0.3.2",
  "author": "dixlib@gmail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dixlib/dixlib.git"
  },
  "bugs": {
    "url": "https://github.com/dixlib/dixlib/issues"
  },
  "license": "MIT",
  "type": "module",
