{
  "compilerOptions": {
    "noEmit": true,
    "target": "esnext",
    "module": "esnext",
    "experimentalDecorators": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "incremental": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true
  }
}
