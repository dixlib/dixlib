{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["*.js", "**/rolldown.config.js", "src/**/*.ts", "server/src/**/*.ts"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "expand": "auto"
  },
  "javascript": {
    "formatter": {
      "trailingCommas": "es5",
      "semicolons": "asNeeded",
      "quoteStyle": "double",
      "arrowParentheses": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "style": {
        "useBlockStatements": "on"
      },
      "correctness": {
        "useYield": "off"
      }
    }
  }
}
